<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/academic_week_root" android:layout_width="match_parent"
 android:layout_height="match_parent" android:background="#D7EBF6">
 <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
  android:src="@drawable/ac_week_landscape" android:scaleType="centerCrop"
  android:contentDescription="Paisaje original PNG del lago y las montañas" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:padding="6dp">
  <FrameLayout android:id="@+id/ac_week_heading" android:layout_width="match_parent"
   android:layout_height="52dp" android:background="@drawable/ac_week_card"
   android:padding="4dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:layout_width="34dp" android:layout_height="34dp"
     android:src="@drawable/ac_week_calendar" android:contentDescription="Calendario" />
    <ImageView android:layout_width="170dp" android:layout_height="40dp"
     android:layout_marginStart="5dp" android:src="@drawable/ac_week_title"
     android:scaleType="fitCenter" android:contentDescription="Mi horario" />
   </LinearLayout>
  </FrameLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="43dp"
   android:orientation="horizontal" android:gravity="center_vertical"
   android:layout_marginTop="4dp">
   <ImageView android:id="@+id/ac_week_previous" android:layout_width="38dp"
    android:layout_height="38dp" android:src="@drawable/ac_week_arrow_prev"
    android:contentDescription="Día anterior" />
   <FrameLayout android:layout_width="0dp" android:layout_weight="1"
    android:layout_height="38dp" android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
     android:src="@drawable/ac_week_selector" android:scaleType="fitXY" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
     android:gravity="center" android:orientation="horizontal" android:padding="2dp">
     <ImageView android:layout_width="21dp" android:layout_height="21dp"
      android:src="@drawable/ac_week_calendar" />
     <TextView android:id="@+id/ac_week_day" android:layout_width="wrap_content"
      android:layout_height="wrap_content" android:layout_marginStart="3dp"
      android:gravity="center" android:text="Hoy · miércoles"
      android:textColor="#08254C" android:textStyle="bold" android:textSize="11sp"
      android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
   </FrameLayout>
   <ImageView android:id="@+id/ac_week_next" android:layout_width="38dp"
    android:layout_height="38dp" android:src="@drawable/ac_week_arrow_next"
    android:contentDescription="Día siguiente" />
  </LinearLayout>
  <FrameLayout android:id="@+id/ac_week_card_1" android:layout_width="match_parent"
   android:layout_height="64dp" android:layout_marginTop="4dp">
   <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/ac_week_card" android:scaleType="fitXY" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp">
    <FrameLayout android:layout_width="44dp" android:layout_height="46dp">
     <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
      android:src="@drawable/ac_week_icon_tile" android:scaleType="fitXY" />
     <ImageView android:id="@+id/ac_week_subject_1" android:layout_width="38dp"
      android:layout_height="38dp" android:layout_gravity="center"
      android:src="@drawable/ac_week_books" />
    </FrameLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="41dp"
     android:layout_marginStart="4dp" android:background="#1D4F77" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
     android:layout_height="wrap_content" android:orientation="vertical"
     android:layout_marginStart="5dp">
     <TextView android:id="@+id/ac_week_course_1" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="Clase programada"
      android:textColor="#0D2A4C" android:textStyle="bold" android:textSize="12sp"
      android:maxLines="1" android:ellipsize="end" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
      <ImageView android:layout_width="13dp" android:layout_height="13dp"
       android:src="@drawable/ac_week_clock" />
      <TextView android:id="@+id/ac_week_time_1" android:layout_width="wrap_content"
       android:layout_height="wrap_content" android:text="08:00–10:00"
       android:textColor="#102F50" android:textSize="9sp" android:maxLines="1"
       android:layout_marginStart="2dp" />
      <ImageView android:layout_width="13dp" android:layout_height="13dp"
       android:layout_marginStart="5dp" android:src="@drawable/ac_week_location" />
      <TextView android:id="@+id/ac_week_room_1" android:layout_width="wrap_content"
       android:layout_height="wrap_content" android:text="Aula"
       android:textColor="#102F50" android:textSize="9sp" android:maxLines="1"
       android:ellipsize="end" android:layout_marginStart="2dp" />
     </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/ac_week_status_1" android:layout_width="29dp"
     android:layout_height="29dp" android:src="@drawable/ac_week_pending"
     android:layout_marginStart="3dp" />
   </LinearLayout>
  </FrameLayout>
  <FrameLayout android:id="@+id/ac_week_card_2" android:layout_width="match_parent"
   android:layout_height="64dp" android:layout_marginTop="4dp">
   <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
    android:src="@drawable/ac_week_card_alt" android:scaleType="fitXY" />
   <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="5dp">
    <FrameLayout android:layout_width="44dp" android:layout_height="46dp">
     <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
      android:src="@drawable/ac_week_icon_tile" android:scaleType="fitXY" />
     <ImageView android:id="@+id/ac_week_subject_2" android:layout_width="38dp"
      android:layout_height="38dp" android:layout_gravity="center"
      android:src="@drawable/ac_week_flask" />
    </FrameLayout>
    <FrameLayout android:layout_width="1dp" android:layout_height="41dp"
     android:layout_marginStart="4dp" android:background="#1D4F77" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1"
     android:layout_height="wrap_content" android:orientation="vertical"
     android:layout_marginStart="5dp">
     <TextView android:id="@+id/ac_week_course_2" android:layout_width="match_parent"
      android:layout_height="wrap_content" android:text="Clase programada"
      android:textColor="#0D2A4C" android:textStyle="bold" android:textSize="12sp"
      android:maxLines="1" android:ellipsize="end" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="3dp">
      <ImageView android:layout_width="13dp" android:layout_height="13dp"
       android:src="@drawable/ac_week_clock" />
      <TextView android:id="@+id/ac_week_time_2" android:layout_width="wrap_content"
       android:layout_height="wrap_content" android:text="10:30–12:30"
       android:textColor="#102F50" android:textSize="9sp" android:maxLines="1"
       android:layout_marginStart="2dp" />
      <ImageView android:layout_width="13dp" android:layout_height="13dp"
       android:layout_marginStart="5dp" android:src="@drawable/ac_week_location" />
      <TextView android:id="@+id/ac_week_room_2" android:layout_width="wrap_content"
       android:layout_height="wrap_content" android:text="Aula"
       android:textColor="#102F50" android:textSize="9sp" android:maxLines="1"
       android:ellipsize="end" android:layout_marginStart="2dp" />
     </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/ac_week_status_2" android:layout_width="29dp"
     android:layout_height="29dp" android:src="@drawable/ac_week_pending"
     android:layout_marginStart="3dp" />
   </LinearLayout>
  </FrameLayout>
 </LinearLayout>
 <!-- Must be the last child: keeps the approved PNG birrete above every other layer. -->
 <ImageView android:id="@+id/ac_week_cap_front" android:layout_width="60dp"
  android:layout_height="60dp" android:layout_gravity="top|end"
  android:src="@drawable/ac_week_cap" android:layout_marginTop="2dp"
  android:layout_marginEnd="1dp" android:elevation="8dp"
  android:contentDescription="Birrete decorativo PNG en primer plano" />
</FrameLayout>