<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="9dp"
    android:orientation="vertical">
    <LinearLayout android:id="@+id/academic_day_header"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:paddingStart="12dp" android:paddingEnd="12dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:background="@drawable/widget_academic_header">
        <TextView android:layout_width="30dp" android:layout_height="40dp"
            android:text="☀" android:textColor="#FFFFFF" android:textSize="24sp"
            android:gravity="center" android:contentDescription="@null"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Mi día académico"
            android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"/>
        <TextView android:id="@+id/academic_day_date"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Hoy" android:textColor="#ECF3FF" android:textSize="11sp"/>
    </LinearLayout>
    <TextView android:id="@+id/academic_day_profile"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="11dp" android:paddingTop="4dp" android:paddingBottom="4dp"
        android:singleLine="true" android:ellipsize="end"
        android:textColor="#566B8F" android:textSize="11sp" android:text="Mi horario"/>
    <LinearLayout android:id="@+id/academic_day_class"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="11dp"
        android:background="@drawable/widget_academic_blue_card">
        <TextView android:id="@+id/academic_day_label"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Próxima clase" android:textColor="#3967D8"
            android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/academic_day_course"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Curso" android:textColor="#142344"
            android:textStyle="bold" android:textSize="16sp"
            android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="4dp">
            <TextView android:id="@+id/academic_day_clock"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="#314968"
                android:textSize="12sp" android:text="9:00 – 11:00"/>
            <TextView android:id="@+id/academic_day_room"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#314968" android:textSize="12sp" android:text="Aula"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="11dp"
        android:paddingEnd="11dp" android:paddingTop="8dp">
        <TextView android:id="@+id/academic_day_tasks_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Tareas de esta clase" android:textColor="#182746"
            android:textStyle="bold" android:textSize="13sp"/>
        <TextView android:id="@+id/academic_day_task1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sin tareas pendientes" android:textColor="#334563"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/academic_day_task2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#334563" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/academic_day_task3"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#334563" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textSize="12sp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="10dp" android:layout_marginTop="6dp"
        android:background="@drawable/widget_academic_lavender_card">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Próxima evaluación" android:textColor="#5943A0"
            android:textStyle="bold" android:textSize="12sp"/>
        <TextView android:id="@+id/academic_day_exam"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Sin evaluaciones" android:textColor="#182746"
            android:textSize="12sp" android:singleLine="true"
            android:ellipsize="end" android:paddingTop="4dp"/>
    </LinearLayout>
    <TextView android:id="@+id/academic_day_pending"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="8dp" android:gravity="center"
        android:text="0 pendientes" android:textColor="#4A6494" android:textSize="11sp"/>
</LinearLayout>