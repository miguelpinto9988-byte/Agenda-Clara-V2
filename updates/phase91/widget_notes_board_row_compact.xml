<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sticky_widget_row" android:layout_width="match_parent"
 android:layout_height="98dp" android:clipChildren="false">
 <ImageView android:id="@+id/sticky_widget_art" android:layout_width="match_parent"
  android:layout_height="match_parent" android:scaleType="fitXY"
  android:src="@drawable/ac_notes_horizontal_yellow"
  android:contentDescription="@null"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:paddingStart="10dp" android:paddingEnd="10dp"
  android:paddingTop="21dp" android:paddingBottom="10dp">
  <TextView android:id="@+id/sticky_widget_title" android:layout_width="match_parent"
   android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end"
   android:text="Título de la nota" android:textColor="#142954" android:textStyle="bold"
   android:textSize="13sp"/>
  <TextView android:id="@+id/sticky_widget_body" android:layout_width="match_parent"
   android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="3dp"
   android:ellipsize="end" android:maxLines="2"
   android:text="Contenido de la nota" android:textColor="#294361" android:textSize="11sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
   android:orientation="horizontal" android:gravity="center_vertical">
   <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ac_notes_date"
    android:contentDescription="@null"/>
   <TextView android:id="@+id/sticky_widget_date" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginStart="3dp" android:singleLine="true" android:ellipsize="end"
    android:textSize="10sp" android:textColor="#38516E"/>
  </LinearLayout>
 </LinearLayout>
 <ImageView android:id="@+id/sticky_widget_pin" android:layout_width="24dp"
  android:layout_height="24dp" android:layout_gravity="top|start" android:layout_marginStart="13dp"
  android:src="@drawable/ac_notes_pin_yellow" android:contentDescription="@null"/>
</FrameLayout>
