<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp"
    android:background="@drawable/widget_academic_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/notes_board_heading"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="📌 Mis notas"
            android:textColor="#182746" android:textSize="17sp"
            android:textStyle="bold"/>
        <TextView android:id="@+id/notes_board_add"
            android:layout_width="48dp" android:layout_height="42dp"
            android:text="＋" android:textColor="#285CF2" android:textSize="28sp"
            android:gravity="center" android:contentDescription="Añadir nota"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <ListView android:id="@+id/notes_board_list"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"/>
        <TextView android:id="@+id/notes_board_empty"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="Aún no tienes notas"
            android:textColor="#66758D" android:textSize="13sp"/>
    </FrameLayout>
</LinearLayout>
