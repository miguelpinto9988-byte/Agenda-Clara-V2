<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="9dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/academic_week_header" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@drawable/widget_academic_header">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="▦  Horario semanal y evaluaciones" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/academic_week_profile" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mi horario" android:paddingStart="11dp" android:paddingTop="5dp" android:paddingBottom="4dp" android:textSize="11sp" android:textColor="#566B8F" android:singleLine="true" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/academic_week_d1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="L" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Lunes"/>
        <TextView android:id="@+id/academic_week_d2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="M" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Martes"/>
        <TextView android:id="@+id/academic_week_d3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="X" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Miércoles"/>
        <TextView android:id="@+id/academic_week_d4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="J" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Jueves"/>
        <TextView android:id="@+id/academic_week_d5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="V" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Viernes"/>
        <TextView android:id="@+id/academic_week_d6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="S" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Sábado"/>
        <TextView android:id="@+id/academic_week_d7" android:layout_width="0dp" android:layout_weight="1" android:layout_height="38dp" android:gravity="center" android:text="D" android:textColor="#263C6A" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/widget_day_idle" android:contentDescription="Domingo"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/academic_week_group1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="9dp" android:layout_marginTop="6dp" android:background="@drawable/widget_academic_blue_card">
        <TextView android:id="@+id/academic_week_course1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Curso" android:textColor="#182746" android:textStyle="bold" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/academic_week_exam1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin evaluaciones registradas" android:textColor="#7046C4" android:textSize="12sp" android:paddingTop="3dp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/academic_week_group2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="9dp" android:layout_marginTop="6dp" android:background="@drawable/widget_academic_blue_card">
        <TextView android:id="@+id/academic_week_course2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Curso" android:textColor="#182746" android:textStyle="bold" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/academic_week_exam2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin evaluaciones registradas" android:textColor="#7046C4" android:textSize="12sp" android:paddingTop="3dp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/academic_week_group3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="9dp" android:layout_marginTop="6dp" android:background="@drawable/widget_academic_blue_card">
        <TextView android:id="@+id/academic_week_course3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Curso" android:textColor="#182746" android:textStyle="bold" android:textSize="13sp" android:singleLine="true" android:ellipsize="end"/>
        <TextView android:id="@+id/academic_week_exam3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sin evaluaciones registradas" android:textColor="#7046C4" android:textSize="12sp" android:paddingTop="3dp" android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/academic_week_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="17dp" android:text="Sin clases registradas" android:gravity="center" android:textSize="13sp" android:textColor="#526888" android:visibility="gone"/>
    <TextView android:id="@+id/academic_week_footer" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:gravity="center" android:text="0 evaluaciones" android:textColor="#4A6494" android:textSize="11sp"/>
</LinearLayout>