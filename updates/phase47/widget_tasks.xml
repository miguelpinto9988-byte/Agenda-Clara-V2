<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="11dp"
    android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="62dp" android:gravity="center_vertical">
        <ImageView android:layout_width="50dp" android:layout_height="50dp"
            android:src="@drawable/ic_ref_widget_brand" android:contentDescription="Agenda Clara" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Agenda Clara" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>
            <TextView android:id="@+id/widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Mis tareas de hoy" android:textColor="#A8ECFF" android:textSize="13sp" android:textStyle="bold"/>
        </LinearLayout>
        <ImageView android:id="@+id/widget_add" android:layout_width="55dp" android:layout_height="55dp"
            android:src="@drawable/ic_ref_widget_plus" android:contentDescription="Añadir tarea rápida o normal" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/widget_list_bg" android:layout_marginTop="5dp">
        <ListView android:id="@+id/widget_list" android:layout_width="match_parent"
            android:layout_height="match_parent" android:divider="#E2E8F4" android:dividerHeight="1dp"
            android:paddingStart="5dp" android:paddingEnd="5dp"/>
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent"
            android:layout_height="match_parent" android:text="Sin tareas. Toca ＋ para comenzar."
            android:textColor="#637392" android:gravity="center" android:textSize="14sp"/>
    </FrameLayout>
</LinearLayout>
